# ============================================================
# AuraCheck / FixMyAura — Environment Variables
# ============================================================

## ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

## ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

## ─── Razorpay ───
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

## ─── Admin ───
ADMIN_ACCESS_CODE=
# Legacy (client-side visible, use ADMIN_ACCESS_CODE instead):
LOCAL_ADMIN_CODE=
NEXT_PUBLIC_LOCAL_ADMIN_CODE=ADMINDEMO

## ─── Support ───
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_OWNER_WHATSAPP=

## ─── Manual Payment Fallback ───
NEXT_PUBLIC_MANUAL_UPI_ID=
NEXT_PUBLIC_DEMO_UNLOCK_CODE=AURADEMO

## ─── Commerce ───
NEXT_PUBLIC_AFFILIATE_DISCLOSURE_ENABLED=true
COMMERCE_REFRESH_SECRET=
AFFILIATE_DEFAULT_COMMISSION_RATE=
# Protects the scheduled /api/cron/refresh-catalog job (Vercel Cron, every 72h).
# Set a long random value; Vercel sends it as an Authorization: Bearer header.
CRON_SECRET=

## ─── Commerce Feed URLs (optional) ───
COMMERCE_GENERIC_CSV_FEED_URL=
COMMERCE_GENERIC_JSON_FEED_URL=
COMMERCE_GENERIC_FEED_TOKEN=

## ─── Live Product Feed (report buy list) ───────────────────
# Off by default: the buy list shows curated picks + retailer SEARCH links.
# Add a key below to upgrade it to the cheapest REAL product, exact live
# price, and a DIRECT product link. Safe to leave blank — it just falls back.
# Full setup guide: docs/live-product-feed.md
#
# 1) LIVE PRICES — no Amazon account needed. Sign up at rapidapi.com,
#    subscribe to an Amazon data API (e.g. "Real-Time Amazon Data"; the free
#    tier is enough to start), and paste the key here:
RAPIDAPI_KEY=
# Optional — only set if your provider's host differs from the default:
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com
# Optional — defaults to "rapidapi_amazon" when RAPIDAPI_KEY is set:
SHOP_FEED_PROVIDER=
#
# 2) GET PAID — your Amazon Associates tag (affiliate-program.amazon.in).
#    Appended to every Amazon link (buy list, grid, report) so purchases are
#    attributed to you. The tag works the moment you sign up; PA-API
#    (first-party data) needs 3 sales in 180 days and is a later upgrade.
#    Use the NEXT_PUBLIC_ one so client-side links carry it too (affiliate
#    tags are public by nature). AMAZON_ASSOCIATE_TAG still works as a
#    server-side fallback for the live feed.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
AMAZON_ASSOCIATE_TAG=

# 3) EARN ON MYNTRA / FLIPKART / AJIO / NYKAA — these have no direct tag, so
#    route their links through ONE affiliate-network account that covers all
#    of them (Cuelinks is the easiest link-kit signup: cuelinks.com).
#    Paste your network's redirect template, keeping the literal {url}. e.g.
#    NEXT_PUBLIC_AFFILIATE_LINK_WRAP_TEMPLATE=https://linksredirect.com/?pub_id=YOURID&source=linkkit&url={url}
#    Leave blank to keep plain (uncommissioned) links.
NEXT_PUBLIC_AFFILIATE_LINK_WRAP_TEMPLATE=
#    Set to "true" to also route Amazon through the network instead of the
#    direct Associates tag (usually leave false — direct pays better).
NEXT_PUBLIC_AFFILIATE_WRAP_AMAZON=false

## ─── Google Maps / Places API (New) — server-side only, never exposed to the client ───
## Powers: nearby salons/gyms (Grooming) AND real venues in the Date & Dining
## Playbook (photo, rating, price, open-now, directions). Enable "Places API (New)"
## on the key. Unset → those features degrade to plain Google-Maps search links.
GOOGLE_MAPS_API_KEY=

## ─── Affiliate Connectors (optional, placeholder — not yet wired) ───
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_FEED_URL=
CUELINKS_API_KEY=
CUELINKS_FEED_URL=
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_ACCESS_TOKEN=
ADMITAD_FEED_URL=

## ─── Voice Dating Coach (optional — DORMANT & FREE until a key is set) ───
# Powers the spoken "practice date" / "coach" feature inside the paid Dating
# Audit. The talking + listening run free in the browser (Web Speech API); only
# short text turns use an LLM. With no key set, the feature stays off and costs
# nothing. Use a FREE-TIER, OpenAI-compatible provider — pick ONE:
#
#   Groq (free tier — console.groq.com):
#     LLM_API_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.1-8b-instant
#
#   Google Gemini (free tier — aistudio.google.com):
#     LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.0-flash
#
# Cost is capped server-side regardless (12-message window, 120-token replies,
# 15-turn sessions, per-IP rate limit), so a chatty user can't run it up.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Emergency kill-switch — set to 1 to instantly disable the voice feature.
VOICE_COACH_DISABLED=

## ─── On-device CLIP (Photo Ranker / AI photo read) ───
# Set to 1 to serve the CLIP weights from your own domain (/public/models) —
# run `npm run clip:fetch` in your build first. Leave blank to load the model
# from the Hugging Face CDN. Either way the user's photo never leaves the browser.
NEXT_PUBLIC_LOCAL_CLIP=

## ─── AI Glow-Up Photoshoot (paid upsell — DORMANT until a key is set) ───
# Powers the "AI Glow-Up Photoshoot" product: the buyer uploads a selfie and we
# generate studio-grade portraits in their matched celebrity's aesthetic. Unlike
# the on-device photo analysis, THIS feature sends the buyer's upload to an
# external image provider — the checkout + /privacy copy disclose that. With no
# key set the product shows "coming soon" (never charges) and generate → 503.
#
# ── RECOMMENDED: Google Gemini image model, FREE tier (aistudio.google.com) ──
# Gemini "nano banana" does reference-conditioned generation (the selfie drives
# the likeness) on a real free tier. Turn it on with just a free key:
#     IMAGE_GEN_PROVIDER=gemini
#     IMAGE_GEN_API_KEY=<your free AI Studio key>
#     # IMAGE_GEN_MODEL defaults to gemini-2.5-flash-image; override if needed.
# Free-tier PRIVACY caveat: Google may use submitted content to improve their
# products per their API terms — that's why the buyer-facing copy says the photo
# is sent to Google's Gemini AI and drops any "never shared" claim. Free-tier
# also has daily request caps, which (with the per-IP rate limit) bound volume.
#
# ── ALTERNATIVE: any face-conditioned endpoint (InstantID / PhotoMaker / etc.) ──
# Leave IMAGE_GEN_PROVIDER unset and point IMAGE_GEN_API_URL at a POST endpoint
# that takes { model, prompt, image, num_images } and returns
# { images: [url-or-dataURL, ...] } (adapt in imageGenClient.ts if needed).
IMAGE_GEN_PROVIDER=
IMAGE_GEN_API_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=
# Emergency kill-switch — set to 1 to instantly disable the photoshoot product.
PHOTOSHOOT_DISABLED=
